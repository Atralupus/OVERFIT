[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://title/Title.cs" id="1_title"]
[ext_resource type="PackedScene" path="res://ui/Backdrop.tscn" id="2_backdrop"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

; 타이틀도 전투와 같은 방을 보여준다. 첫 화면이 단색이면 "아직 아무것도 없다" 로 읽히는데,
; 배경 한 벌을 씬으로 뽑아 뒀으므로(ui/Backdrop.tscn) 여기 한 줄이면 된다.
[node name="Backdrop" parent="." instance=ExtResource("2_backdrop")]

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Name" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 96
text = "OVERFIT"
horizontal_alignment = 1

[node name="StartButton" type="Button" parent="Center/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 88)
layout_mode = 2
text = "시작"

; 조작 안내. 칸은 Title.cs 가 InputMap 에서 읽어 채운다 — 씬에 키 글자를 적어두면
; 바인딩이 바뀌는 순간 안내만 거짓이 되고 아무도 모른다.
[node name="Controls" type="GridContainer" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 28
theme_override_constants/v_separation = 8
columns = 2

; 크레딧으로 들어가는 유일한 문. 시작 버튼보다 작게 둔다 — 첫 화면에서 눈이 먼저 가야 할 곳은 시작이다.
[node name="CreditsButton" type="Button" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 24
text = "크레딧"
