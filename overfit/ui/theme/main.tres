corner_radius_bottom_left = 6

; 스태미나 = 초록. 체력과 **색상환에서 멀어야** 곁눈으로도 구별된다.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_stamina"]
bg_color = Color(0.356863, 0.807843, 0.415686, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
