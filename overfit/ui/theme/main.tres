corner_radius_bottom_left = 6

; 경직 게이지 = 흰색 계열 (#71 · 설계 §6). 빨간 체력바 바로 밑이라 색상이 아니라 **밝기**로 갈린다 — 호박은 "막아도 되는
; 연타" 라 안 쓴다(보스의 선딜 링과 틴트가 호박이다).
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar_poise"]
bg_color = Color(0.905882, 0.921569, 0.960784, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

; 탈진 = 파랑 (#71). 보스의 탈진 틴트(푸른 톤)와 같은 쪽이다 — 보스 게이지의 탈진과 파이터 스태미나 바의 탈진이 같은 색이다:
; "지금은 아무것도 못 한다" 가 누구의 것이든 한 색으로 읽힌다.
