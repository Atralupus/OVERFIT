; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OVERFIT"
config/version="0.6.0"
run/main_scene="res://title/Title.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

; 등록 순서가 곧 초기화 순서다. Balance → Game.
; Game 이 마지막이라 _Ready 에서 앞의 것들을 쓸 수 있다. 새 Autoload 는 Game 앞에 넣는다.
Balance="*res://core/Balance.cs"
Game="*res://core/Game.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

; 전투 시뮬레이션이 여기에 얹혀 돈다 (Battle._PhysicsProcess). 규칙의 고정 틱(BattleSim.Dt = 1/60)과
; **같은 수여야 한다** — 어긋나면 한 물리 틱이 1/60초가 아닌 시간을 진행시킨 셈이 되고,
; 입력 엣지도 틱과 다른 주기로 들어온다. 엔진 기본값과 같지만 명시한다: 이 값은 계약이다.
common/physics_ticks_per_second=60

[gui]

; 전역 Theme 하나. 색·폰트·여백은 여기서만 정의한다.
theme/custom="res://ui/theme/main.tres"

[dotnet]

project/assembly_name="Overfit"

[input]

; 이동은 **레벨**이다 (IsActionPressed) — 누르고 있으면 계속 가야 한다. 레벨은 이동과 가드(아래) 둘뿐이다.
; 원시 키코드로 직접 읽지 않고 액션으로 둔 이유는 타이틀의 조작 안내가 이 표에서 글자를 뽑기 때문이다.
; 손으로 적은 안내는 바인딩이 바뀌는 순간 거짓말이 된다.
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194319,"pressed":true), Object(InputEventKey,"keycode":65,"pressed":true)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194321,"pressed":true), Object(InputEventKey,"keycode":68,"pressed":true)]
}

; 아래 넷은 엣지로 읽는다 (IsActionJustPressed). 레벨로 읽으면 누르고 있는 동안 매 틱 발동한다.
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32,"pressed":true)]
}
dash={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194325,"pressed":true)]
}
parry={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":75,"pressed":true)]
}
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":74,"pressed":true)]
}

; 가드만 **레벨**로 읽는다 (IsActionPressed) — 누르고 있는 동안이 곧 가드다 (설계 §5.2). ↓ 와 S.
guard={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194322,"pressed":true), Object(InputEventKey,"keycode":83,"pressed":true)]
}

; 디버그 전용 — 전투 중 그 단계로 바로 건너뛴다 (이슈 #54). 숫자 키 1 · 2 · 3 이고 액션 이름의 끝이 곧 단계다.
; **이름이 debug_ 로 시작하는 액션은 두 곳이 가른다.** 처리하는 Game._UnhandledInput 은 OS.IsDebugBuild() 로
; 막아 릴리즈 빌드에서는 안 먹고(--tour · --shots 와 같은 선례다), 타이틀의 조작 안내(Title._rows)는
; 이 접두어를 안 싣는다 — 릴리즈에서 안 먹는 키를 안내에 적으면 안내가 거짓말이 된다.
debug_stage_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":49,"pressed":true)]
}
debug_stage_2={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":50,"pressed":true)]
}
debug_stage_3={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":51,"pressed":true)]
}

[rendering]

; 데스크톱 전용이다 — 모바일은 목표가 아니다. 그래서 데스크톱 기본값인 forward_plus 를 쓴다.
; 2D 뿐이라 렌더러 선택이 성능에 거의 영향이 없고, mobile 을 남겨두면 "모바일도 하나?" 라는 오해만 남는다.
renderer/rendering_method="forward_plus"
; macOS 를 universal(= arm64 포함)로 익스포트하려면 켜져 있어야 한다 — 꺼져 있으면 익스포트가
; "Cannot export for universal or arm64 if ETC2 ASTC texture format is disabled" 로 멈춘다.
; 데스크톱 전용이라 이 포맷을 쓸 일이 없는데도 켜는 이유는 그것뿐이다. 대가는 임포트 캐시가 커지는 것.
textures/vram_compression/import_etc2_astc=true
; 화면 바탕색. Control 은 스스로 배경을 칠하지 않으므로 여기가 유일한 바탕이다.
environment/defaults/default_clear_color=Color(0.070588, 0.078431, 0.109804, 1)
