[node name="Battle" type="Node2D"]
script = ExtResource("1_battle")

; 배경은 ui/Backdrop.tscn 한 벌을 타이틀과 같이 쓴다. CanvasLayer(layer = -1)라 World 보다 뒤에 그려지고,
; World 밖이라 화면 흔들림을 안 탄다 — 먼 배경이 앞의 것과 똑같이 흔들리면 거리감이 사라진다.
[node name="Backdrop" parent="." instance=ExtResource("6_backdrop")]

[node name="World" type="Node2D" parent="."]
; 규칙의 y 는 위가 +이고 바닥이 0 이다. 화면은 아래가 +라 뷰가 -y 로 뒤집고,
; 이 노드를 내려 바닥을 화면 아래쪽에 둔다.
position = Vector2(0, 900)

; 바닥은 World 안이라 싸우는 둘과 **같이 흔들린다.** 배경(Backdrop)은 안 흔들린다 — 그 어긋남이 거리감이다.
; 좌우로 화면 밖까지 나가 있는 것은 흔들릴 때 가장자리에 틈이 생기지 않게 하려는 것이다.
