# ---------- Godot 4+ ----------
.godot/
/overfit/.godot/
/overfit/android/
# export_presets.cfg 는 커밋한다 — 이게 없으면 익스포트가 남의 기계에서 안 돈다.
# 서명 키스토어 비밀번호 등은 Godot 이 export_credentials.cfg 에 따로 담는다. 그건 커밋하지 않는다.
export_credentials.cfg
*.translation

# Godot 익스포트 산출물
/build/
/builds/
/export/
*.apk
*.aab
*.ipa
*.pck
*.zip
*.dmg
*.exe

# ---------- .NET / C# (Godot mono) ----------
.mono/
bin/
obj/
[Bb]in/
[Oo]bj/
*.user
*.userprefs
*.suo
*.csproj.user
.vs/
*.sln.DotSettings.user

# ---------- Python ----------
# tools/*.py 를 직접 돌리면 생긴다. 받는 스크립트를 안내하는 저장소가 그 부산물을 안 무시하면
# 다음 사람이 그대로 커밋한다.
__pycache__/
*.pyc

# ---------- 테스트 산출물 ----------
# tools/build.sh test 는 out/TestResults 로 떨어뜨리지만, IDE 테스트 탐색기는 프로젝트 옆에 만든다.
TestResults/
*.trx
*.coverage
coverage.cobertura.xml

# ---------- 빌드 · 검증 산출물 ----------
# 헤드리스 로그 · 스크린샷 · 테스트 결과가 전부 여기로 떨어진다.
out/

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ---------- Windows ----------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk

# ---------- Linux ----------
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---------- 에디터 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ---------- 기타 ----------
*.log
.env
.env.local

# 작업 중 메모와 보고서. 저장소의 산출물이 아니라 그때그때의 기록이다 —
# .superpowers/sdd/ 는 이미 자기 .gitignore 로 스스로를 지우고 있었는데 그 위 폴더가 비어 있었고,
# 그래서 보고서 하나가 실수로 커밋에 딸려 들어갔다(같은 커밋에서 되돌렸다).
.superpowers/

# Claude Code 병렬 작업 워크트리 — 절대 커밋하지 않는다
.claude/worktrees/
# 개인 설정. .claude/settings.json(공유되는 훅 설정)은 커밋한다.
.claude/settings.local.json

# ---------- 에셋 ----------
# 원본(PNG)은 커밋하지 않는다. **라이선스 때문이 아니라 저장소 위생 때문이다** —
# Duelyst 는 CC0 라 재배포해도 되지만, 한 번 들어간 바이너리는 히스토리에서 빠지지 않는다.
# .import · .tres 와 라이선스 파일만 추적한다 — uid 와 임포트 설정이 .import 에 있고, 그게 없으면 체크아웃마다 uid 가 갈린다.
# `overfit/addons/duelyst_animated_sprites/*` 로 쓰면 하위 폴더가 통째로 빠져 되살릴 수 없다. 그래서 네 줄이다.
overfit/addons/duelyst_animated_sprites/**
!overfit/addons/duelyst_animated_sprites/**/
!overfit/addons/duelyst_animated_sprites/**/*.import
!overfit/addons/duelyst_animated_sprites/**/*.tres
!overfit/addons/duelyst_animated_sprites/duelyst-LICENSE
!overfit/addons/duelyst_animated_sprites/duelyst-README.md
